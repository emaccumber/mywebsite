---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryNav from '../../components/GalleryNav.astro';
import { films, getMovingAlbumBaseUrl, getMovingAlbumPoster } from '../../data/films.js';

export async function getStaticPaths() {
  const paths = await Promise.all(
    films.map(async (film) => {
      let videoWidth = 16;
      let videoHeight = 9;

      // Fetch dimensions from Vimeo oEmbed API for Vimeo films
      if (film.type === 'vimeo') {
        try {
          const response = await fetch(
            `https://vimeo.com/api/oembed.json?url=https://vimeo.com/${film.vimeoId}`
          );
          if (response.ok) {
            const data = await response.json();
            if (data.width && data.height) {
              videoWidth = data.width;
              videoHeight = data.height;
            }
          }
        } catch (error) {
          console.warn(`Failed to fetch dimensions for ${film.slug}, using 16:9 fallback`);
        }
      }

      return {
        params: { film: film.slug },
        props: { film, videoWidth, videoHeight }
      };
    })
  );

  return paths;
}

const { film, videoWidth, videoHeight } = Astro.props;
const baseUrl = film.type === 'moving-album' ? getMovingAlbumBaseUrl(film.slug) : null;
---

<BaseLayout pageTitle={`${film.name} - Films`} preconnectMedia={film.type === 'moving-album'}>
  <div class="film-container">
    {film.type === 'vimeo' ? (
      <div class="film-page-wrapper">
        <div class="vimeo-wrapper">
          <iframe
            class="vimeo-iframe"
            style={`aspect-ratio: ${videoWidth} / ${videoHeight}`}
            src={`https://player.vimeo.com/video/${film.vimeoId}?dnt=1&color=ffffff&title=0&byline=0&portrait=0`}
            frameborder="0"
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>

          {film.description && (
            <div class="film-description">
              <p>{film.description}</p>
            </div>
          )}
        </div>
      </div>
    ) : (
      <div class="moving-album-container">
        <div class="video-viewer">
          {film.videos.map((video, index) => (
            <video
              class={`video-item ${index === 0 ? 'active' : ''}`}
              data-index={index + 1}
              src={`${baseUrl}/${index + 1}_optimized.mp4`}
              poster={getMovingAlbumPoster(film.slug, index + 1)}
              muted
              playsinline
              disablepictureinpicture
              preload={index === 0 ? 'metadata' : 'none'}
            ></video>
          ))}
          <div class="caption" id="video-caption">{film.videos[0]?.caption || ''}</div>
        </div>

        <GalleryNav prevId="prev-video-btn" nextId="next-video-btn" prevLabel="Previous video" nextLabel="Next video" />

        {film.description && (
          <div class="film-description">
            <p>{film.description}</p>
          </div>
        )}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .film-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .film-page-wrapper {
    margin: 0 -1rem;
  }

  .vimeo-wrapper {
    width: 100%;
  }

  /* Responsive video iframe with dynamic aspect ratio */
  .vimeo-iframe {
    width: 100%;
    height: auto;
    /* aspect-ratio is set inline via videoWidth/videoHeight props for pixel-perfect matching */
    border: none;
    display: block;
  }

  .film-description {
    margin-top: 2rem;
    max-width: 800px;
  }

  .film-description p {
    line-height: 1.6;
    color: var(--text-primary);
    font-size: 0.8rem;
    white-space: pre-line;
  }

  /* Moving Album Styles */
  .moving-album-container {
    min-height: calc(100vh - 120px);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2rem 0.25rem;
  }

  .video-viewer {
    width: 100%;
    max-width: 1200px;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .video-item {
    max-width: 100%;
    max-height: 70vh;
    width: auto;
    height: auto;
    cursor: default;
    user-select: none;
    display: none;
  }

  .video-item.active {
    display: block;
    /* Sit above the nav click areas so scrubbing still works on the video */
    position: relative;
    z-index: 11;
  }

  .caption {
    position: absolute;
    bottom: -1.4rem;
    right: 0;
    font-size: 0.8rem;
    color: var(--text-secondary);
    min-height: 1rem;
  }

  @media (max-width: 768px) {
    .film-container {
      padding: 1rem;
    }
  }
</style>

{film.type === 'moving-album' && (
  <script define:vars={{ baseUrl, totalVideos: film.videos.length, videos: film.videos }}>
    const SCRUB_THROTTLE_MS = 50; // Mouse scrub update interval

    document.addEventListener('DOMContentLoaded', () => {
      const videoElements = document.querySelectorAll('.video-item');
      const prevBtn = document.getElementById('prev-video-btn');
      const nextBtn = document.getElementById('next-video-btn');
      const caption = document.getElementById('video-caption');
      const isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
      let currentIndex = 1;
      let isHovering = false;
      let activeVideo = videoElements[0];
      let loadedVideos = new Set(); // Track which videos have full data loaded

      function getCurrentVideo() {
        return document.querySelector('.video-item.active');
      }

      // Load a video's full data
      function loadVideo(index) {
        if (loadedVideos.has(index)) return;
        if (index < 1 || index > totalVideos) return;

        const video = videoElements[index - 1];
        if (video) {
          video.preload = 'auto';
          video.load();
          loadedVideos.add(index);
        }
      }

      function updateVideo(index) {
        if (index < 1 || index > totalVideos) return;
        
        // Instant switch - no loading delay
        videoElements.forEach((vid, i) => {
          vid.classList.remove('active');
          vid.pause();
          vid.style.display = ''; // Reset any inline styles
        });
        
        const newVideo = videoElements[index - 1];
        newVideo.classList.add('active');
        newVideo.style.display = ''; // Reset any inline styles
        activeVideo = newVideo;
        currentIndex = index;
        
        // Update caption
        const videoCaption = videos[index - 1]?.caption || '';
        caption.textContent = videoCaption;
        
        // Update button states
        if (index === 1) {
          prevBtn.classList.add('disabled');
        } else {
          prevBtn.classList.remove('disabled');
        }
        
        if (index === totalVideos) {
          nextBtn.classList.add('disabled');
        } else {
          nextBtn.classList.remove('disabled');
        }
        
        // Ensure adjacent videos are loaded for smooth navigation
        loadVideo(index - 1);
        loadVideo(index + 1);
        
        // Position elements for new video
        positionElements();
        
        // Autoplay when switching videos
        newVideo.currentTime = 0;
        playVideo(newVideo);
      }

      function positionElements() {
        const video = getCurrentVideo();
        if (!video) return;
        
        const videoRect = video.getBoundingClientRect();
        const viewerRect = video.parentElement.getBoundingClientRect();
        
        // Position caption to right edge of video
        const rightOffset = viewerRect.right - videoRect.right;
        caption.style.right = rightOffset + 'px';
      }

      // Play unless the pointer is holding the clip or it has reached the end
      function playVideo(video) {
        if (isHovering || video.currentTime >= video.duration) return;
        video.play().catch(err => console.log('Autoplay failed:', err));
      }

      // Position elements after videos load
      videoElements.forEach(video => {
        video.addEventListener('loadedmetadata', positionElements);
      });
      window.addEventListener('resize', positionElements);

      // Desktop: hovering pauses the clip like a hand on a DJ wheel,
      // moving left/right scrubs relative to the current frame, leaving resumes
      if (!isTouchDevice) {
        let lastX = 0;
        let lastScrubTime = 0;
        videoElements.forEach(video => {
          video.addEventListener('mouseenter', (e) => {
            isHovering = true;
            lastX = e.clientX;
            video.pause();
          });

          video.addEventListener('mousemove', (e) => {
            if (!video.classList.contains('active') || !(video.duration > 0)) return;
            const now = Date.now();
            // Throttle for smoother scrubbing; lastX only advances when applied
            if (now - lastScrubTime < SCRUB_THROTTLE_MS) return;
            const rect = video.getBoundingClientRect();
            const delta = (e.clientX - lastX) / rect.width * video.duration;
            video.currentTime = Math.max(0, Math.min(video.duration, video.currentTime + delta));
            lastX = e.clientX;
            lastScrubTime = now;
          });

          video.addEventListener('mouseleave', () => {
            isHovering = false;
            if (video.classList.contains('active')) playVideo(video);
          });
        });
      }

      // Video navigation
      prevBtn.addEventListener('click', () => {
        if (currentIndex > 1) {
          updateVideo(currentIndex - 1);
        }
      });

      nextBtn.addEventListener('click', () => {
        if (currentIndex < totalVideos) {
          updateVideo(currentIndex + 1);
        }
      });

      // Keyboard navigation
      document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft' && currentIndex > 1) {
          updateVideo(currentIndex - 1);
        } else if (e.key === 'ArrowRight' && currentIndex < totalVideos) {
          updateVideo(currentIndex + 1);
        }
      });

      // Initial setup
      positionElements();

      // Load first video fully once metadata is ready, then preload next
      activeVideo.addEventListener('loadedmetadata', () => {
        positionElements();
        loadVideo(1);
        loadVideo(2);
      }, { once: true });

      // If metadata is already loaded (cached)
      if (activeVideo.readyState >= 1) {
        loadVideo(1);
        loadVideo(2);
      }

      // Autoplay first video
      activeVideo.addEventListener('canplay', () => playVideo(activeVideo), { once: true });
    });
  </script>
)}