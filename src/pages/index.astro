---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
const mediaUrl = import.meta.env.PUBLIC_MEDIA_URL;
---

<BaseLayout fullViewport={true}>
  <div class="hero-container">
    <Picture
      src={`${mediaUrl}/images/photographs/marfa/7.jpg`}
      alt="Featured image"
      inferSize
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      widths={[800, 1200, 1600, 2048]}
      sizes="min(100vw, calc((100vh - 5rem) * 1.25))"
      loading="eager"
      fetchpriority="high"
      class="hero-image"
    />
  </div>
</BaseLayout>

<style>
  .hero-container {
    height: 100%;
    padding: 0.3rem;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  /* Let the <img> inside <picture> stay the flex item so its max-height still resolves */
  .hero-container picture {
    display: contents;
  }

  .hero-image {
    max-height: calc(100% - 0.6rem);
    max-width: calc(100% - 0.6rem);
    width: auto;
    height: auto;
    object-fit: contain;
    object-position: top;
  }
</style>
